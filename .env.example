# ==============================================================================
# MCA Career Compass — Environment Configuration Example
# Copy this file to `.env` and fill in your local PostgreSQL and secret values.
# NEVER commit `.env` to version control.
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database (PostgreSQL 13+)
POSTGRES_DB=mca_career_compass
POSTGRES_USER=mca_compass_user
POSTGRES_PASSWORD=replace-with-local-db-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Security & Session
SESSION_COOKIE_AGE=28800
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
BEHIND_HTTPS_PROXY=False
AUDIT_IP_HMAC_KEY=replace-with-a-random-hmac-key-for-ip-hashing

# File Upload Limits (MB)
MAX_IMPORT_FILE_SIZE_MB=10

# Email (Console backend in local development; never log/email plaintext passwords)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@mca-career-compass.local

# Frontend (Vite)
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=MCA Career Compass

